# --- Mode (discovery-only is the shipped default; execution additionally requires
# --- a passing runtime geoblock/eligibility check before any Polymarket order path)
ARB_MODE=discovery-only

# --- Database (SQLite default; swap to Postgres by URL)
ARB_DATABASE_URL=sqlite+aiosqlite:///arb_scanner.db

# --- Kalshi (RSA-PSS API key auth)
ARB_KALSHI_API_KEY_ID=
ARB_KALSHI_PRIVATE_KEY_PATH=

# --- Polymarket (execution path only; not needed for discovery)
ARB_POLYMARKET_PRIVATE_KEY=
ARB_POLYMARKET_API_KEY=
ARB_POLYMARKET_API_SECRET=
ARB_POLYMARKET_API_PASSPHRASE=

# --- Alerts
ARB_DISCORD_WEBHOOK_URL=
ARB_TELEGRAM_BOT_TOKEN=
ARB_TELEGRAM_CHAT_ID=
ARB_SMTP_HOST=
ARB_SMTP_PORT=587
ARB_SMTP_USER=
ARB_SMTP_PASSWORD=
ARB_ALERT_EMAIL_TO=
