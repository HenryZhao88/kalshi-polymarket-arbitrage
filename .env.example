# --- Mode (discovery-only is the shipped default; execution additionally requires
# --- a passing runtime geoblock/eligibility check before any Polymarket order path)
ARB_MODE=discovery-only

# --- Database (SQLite default; swap to Postgres by URL)
ARB_DATABASE_URL=sqlite+aiosqlite:///arb_scanner.db
ARB_PERSIST_SCANS=true
# Conflict-free low-similarity raw pairs are omitted by default. Manual-review,
# accepted, and bounded structured-rejection evidence remains persisted.
ARB_PERSIST_RAW_CANDIDATES=false
# Rows older than the retention window are pruned at the start of each persisted
# scan pass; prune on demand with `arb-scanner report --cleanup-retention`.
ARB_STORAGE_RETENTION_DAYS=30
# Per-scan cap on persisted structured rejections; manual-review and accepted
# rows are not subject to the cap.
ARB_STORAGE_MAX_CANDIDATES_PER_SCAN=5000

# --- Full-venue discovery (high caps are guardrails; loops stop when a venue
# is exhausted). Lower these to sample a slice of the universe per pass and cut
# scan time. Gamma documents a maximum page size of 100.
ARB_POLYMARKET_MAX_MARKETS=50000
ARB_POLYMARKET_PAGE_SIZE=100
ARB_POLYMARKET_MAX_PAGES=500
# Kalshi REST discovery pagination (page_limit per request, max pages per pass).
ARB_KALSHI_PAGE_LIMIT=1000
ARB_KALSHI_MAX_PAGES=200

# --- Safety and fail-closed inputs
ARB_KILL_SWITCH_FILE=.arb-scanner.kill
ARB_ALLOW_UNKNOWN_FEES=false
ARB_ALLOW_UNKNOWN_COSTS=false
ARB_ALLOW_UNKNOWN_HOLD_TIME=false
ARB_ALLOW_UNKNOWN_QUOTE_AGE=false

# Per evaluated two-leg opportunity. Leave unset when unknown; candidates then reject
# unless ARB_ALLOW_UNKNOWN_COSTS=true. Zero is an explicit operator assertion, not a default.
ARB_BRIDGE_COST_DOLLARS=
ARB_WITHDRAWAL_COST_DOLLARS=
ARB_GAS_COST_DOLLARS=
ARB_PROCESSOR_COST_DOLLARS=
ARB_CONVERSION_COST_DOLLARS=
ARB_UNKNOWN_COST_BUFFER_DOLLARS=0

# --- Kalshi (RSA-PSS API key auth)
ARB_KALSHI_API_KEY_ID=
ARB_KALSHI_PRIVATE_KEY_PATH=

# --- Polymarket (execution path only; not needed for discovery)
ARB_POLYMARKET_PRIVATE_KEY=
ARB_POLYMARKET_API_KEY=
ARB_POLYMARKET_API_SECRET=
ARB_POLYMARKET_API_PASSPHRASE=

# --- Alerts
# Dry-run never calls external sinks unless this is explicitly true.
ARB_DRY_RUN_SEND_ALERTS=false
ARB_DISCORD_WEBHOOK_URL=
ARB_TELEGRAM_BOT_TOKEN=
ARB_TELEGRAM_CHAT_ID=
ARB_SMTP_HOST=
ARB_SMTP_PORT=587
ARB_SMTP_USER=
ARB_SMTP_PASSWORD=
ARB_ALERT_EMAIL_TO=
